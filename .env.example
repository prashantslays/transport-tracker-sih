# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/transport-tracker
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/transport-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/transport-tracker

# Server port
PORT=4000

# CORS origin (the Next.js app)
CORS_ORIGIN=http://localhost:3000
